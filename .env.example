# WordPress/WooCommerce ব্যাকএন্ডের ঠিকানা (শেষে / ছাড়া)।
# এটা দিয়েই ঠিক হয় কোন সাইট: wp.sunnaherpower.com → sunnaherpower.com, wp.sunnahersopan.com → sunnahersopan.com
# সাইটভেদে আলাদা লিংক (ইমেইল, Facebook পেজ) lib/site.ts-এ
WP_URL=https://wp.sunnaherpower.com

# Facebook পিক্সেল আর Conversions API টোকেন (পিক্সেল ব্রাউজার আর সার্ভার দুই জায়গাতেই ব্যবহার হয়)
FB_PIXEL_ID=
FB_ACCESS_TOKEN=

# WordPress-এর sunnaher প্লাগিনের অর্ডারের চাবি
SUNNAHER_ORDER_KEY=

# WooCommerce > Settings > Advanced > REST API থেকে (Read/Write)
# শুধু সার্ভারে থাকে, ব্রাউজারে কখনো যায় না
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# mock = অর্ডার লাইভ সাইটে যাবে না (ডেমো/টেস্টের জন্য)
# live = আসল অর্ডার তৈরি হবে
ORDER_MODE=mock
